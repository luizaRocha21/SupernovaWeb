digraph G {
rankdir=LR; nodesep=0.22; ranksep=0.75; size="15,8.2!"; ratio=fill; splines=true; pad=0.3; bgcolor="white";
node [shape=plaintext, fontname="Helvetica"]; edge [fontname="Helvetica", fontsize=9, color="#374151", arrowhead=vee, labeldistance=1.6];
PersistenceEntity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7280" STYLE="DASHED"><TR><TD BGCOLOR="#E5E7EB"><FONT POINT-SIZE="11"><I>«abstract» PersistenceEntity</I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- id: Long<BR ALIGN="LEFT"/>- criadoEm: LocalDateTime<BR ALIGN="LEFT"/>- atualizadoEm: LocalDateTime<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
Usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7280"><TR><TD BGCOLOR="#1B2A4A"><FONT COLOR="white" POINT-SIZE="12"><B>Usuario</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- nome: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- telefone: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- senhaHash: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- perfil: Perfil</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- abastecimento: Abastecimento</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- consentimentoLocalizacao: boolean</FONT></TD></TR></TABLE>>];
Localidade [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7280"><TR><TD BGCOLOR="#1B2A4A"><FONT COLOR="white" POINT-SIZE="12"><B>Localidade</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- nome: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- tipo: TipoLocalidade</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- latitude: Double</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- longitude: Double</FONT></TD></TR></TABLE>>];
Cultura [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7280"><TR><TD BGCOLOR="#1B2A4A"><FONT COLOR="white" POINT-SIZE="12"><B>Cultura</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- nome: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- tipoCriterio: TipoCriterio</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- limiarPadraoMm: Double</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- janelaDias: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- fonteLimiar: String</FONT></TD></TR></TABLE>>];
CulturaLimiarUsuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7280"><TR><TD BGCOLOR="#1B2A4A"><FONT COLOR="white" POINT-SIZE="12"><B>CulturaLimiarUsuario</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- limiarMm: Double</FONT></TD></TR></TABLE>>];
Precipitacao [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7280"><TR><TD BGCOLOR="#1B2A4A"><FONT COLOR="white" POINT-SIZE="12"><B>Precipitacao</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- volumeMm: Double</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- dataEvento: LocalDate</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- fonte: FontePrecipitacao</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- idClienteSync: String</FONT></TD></TR></TABLE>>];
SerieHistorica [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7280"><TR><TD BGCOLOR="#1B2A4A"><FONT COLOR="white" POINT-SIZE="12"><B>SerieHistorica</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- mes: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- normalMm: Double</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- anosBase: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- fonte: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- fonteAtualizadaEm: LocalDateTime</FONT></TD></TR></TABLE>>];
ObservacaoExterna [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7280"><TR><TD BGCOLOR="#1B2A4A"><FONT COLOR="white" POINT-SIZE="12"><B>ObservacaoExterna</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- dataObservacao: LocalDate</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- valorMm: Double</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- fonte: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- fonteAtualizadaEm: LocalDateTime</FONT></TD></TR></TABLE>>];
SugestaoPlantio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7280"><TR><TD BGCOLOR="#1B2A4A"><FONT COLOR="white" POINT-SIZE="12"><B>SugestaoPlantio</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- resultado: NivelSugestao</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- dadoUsadoMm: Double</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- referenciaMm: Double</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- fonteDado: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- dataDado: LocalDateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- grauConfianca: Double</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- justificativa: String</FONT></TD></TR></TABLE>>];
Reservatorio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7280"><TR><TD BGCOLOR="#1B2A4A"><FONT COLOR="white" POINT-SIZE="12"><B>Reservatorio</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- tipo: TipoReservatorio</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- apelido: String</FONT></TD></TR></TABLE>>];
RegistroNivel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7280"><TR><TD BGCOLOR="#1B2A4A"><FONT COLOR="white" POINT-SIZE="12"><B>RegistroNivel</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- nivelPercentual: Integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- escala: EscalaNivel</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- dataRegistro: LocalDate</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- idClienteSync: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- pendenteSincronizacao: boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- registradoEmCliente: LocalDateTime</FONT></TD></TR></TABLE>>];
Alerta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7280"><TR><TD BGCOLOR="#1B2A4A"><FONT COLOR="white" POINT-SIZE="12"><B>Alerta</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- tipo: TipoAlerta</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- severidade: Severidade</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- mensagem: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- vigenciaInicio: LocalDateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- vigenciaFim: LocalDateTime</FONT></TD></TR></TABLE>>];
Aviso [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7280"><TR><TD BGCOLOR="#B7791F"><FONT COLOR="white" POINT-SIZE="12"><B>Aviso</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- titulo: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- descricao: String</FONT></TD></TR></TABLE>>];
ChecklistSanitario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7280"><TR><TD BGCOLOR="#B7791F"><FONT COLOR="white" POINT-SIZE="12"><B>ChecklistSanitario</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- calhasLimpas: boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- descartePrimeiraChuva: boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">- conforme(): boolean</FONT></TD></TR></TABLE>>];
Nota [shape=note, fontsize=10, label="Todas as entidades estendem PersistenceEntity\n(id, criadoEm, atualizadoEm) e usam LAZY por padrão."];
Nota -> PersistenceEntity [style=dotted, arrowhead=none, color="#6B7280"];
Usuario -> Localidade [label="pertence a", taillabel="0..*", headlabel="1"];
Localidade -> Localidade [label="pai (município)", taillabel="0..*", headlabel="0..1"];
CulturaLimiarUsuario -> Usuario [taillabel="0..*", headlabel="1"];
CulturaLimiarUsuario -> Cultura [taillabel="0..*", headlabel="1"];
Precipitacao -> Usuario [taillabel="0..*", headlabel="1"];
Precipitacao -> Localidade [taillabel="0..*", headlabel="1"];
SerieHistorica -> Localidade [taillabel="0..*", headlabel="1"];
ObservacaoExterna -> Localidade [taillabel="0..*", headlabel="1"];
SugestaoPlantio -> Usuario [taillabel="0..*", headlabel="1"];
SugestaoPlantio -> Localidade [taillabel="0..*", headlabel="1"];
SugestaoPlantio -> Cultura [taillabel="0..*", headlabel="1"];
Reservatorio -> Usuario [label="responsável", taillabel="0..*", headlabel="1"];
Reservatorio -> Localidade [taillabel="0..*", headlabel="1"];
RegistroNivel -> Reservatorio [taillabel="0..*", headlabel="1"];
Alerta -> Localidade [taillabel="0..*", headlabel="1"];
Alerta -> Usuario [label="emitidoPor", taillabel="0..*", headlabel="1"];
Aviso -> Localidade [taillabel="0..*", headlabel="1" style=dashed];
Aviso -> Usuario [label="autor", taillabel="0..*", headlabel="1" style=dashed];
ChecklistSanitario -> Reservatorio [taillabel="0..*", headlabel="1" style=dashed];
subgraph cluster_leg { label="Legenda"; fontname="Helvetica"; fontsize=10; color="#9CA3AF";L1 [shape=box, style=filled, fillcolor="#1B2A4A", fontcolor=white, fontsize=10, label="Núcleo do MVP"];L2 [shape=box, style=filled, fillcolor="#B7791F", fontcolor=white, fontsize=10, label="Atrás de feature flag (gate de validação)"]; L1 -> L2 [style=invis]; }
}